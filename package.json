{
  "name": "dsh-prompt-easymanager",
  "version": "0.3.3",
  "description": "给 DeepSeek Harness 用的个人提示词管理器：把「个人提示词 + 系统提示词改动」存成预设，按会话或全局挂载，并能改写、关闭、还原 DSH 的原生段落，还能看清模型实际收到的最终提示词。",
  "type": "module",
  "main": "./index.js",
  "license": "MIT",
  "author": "XialerMoies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XialerMoies/dsh-prompt-easymanager.git"
  },
  "homepage": "https://github.com/XialerMoies/dsh-prompt-easymanager#readme",
  "bugs": {
    "url": "https://github.com/XialerMoies/dsh-prompt-easymanager/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "prompt",
    "prompt-manager",
    "system-prompt"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.7"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./client.js": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "client.*.js",
    "cordis.patch.yml",
    "scripts/lib/heartbeat.mjs",
    "scripts/lib/library-migration.mjs",
    "scripts/lib/presets.mjs",
    "scripts/lib/prompt-library.mjs",
    "scripts/lib/section-overrides.mjs",
    "scripts/lib/section-slots.mjs",
    "scripts/lib/session-injection.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/permissions.md",
    "docs/install.md"
  ],
  "scripts": {
    "harness:check": "node scripts/check-syntax.mjs && node scripts/check-props.mjs",
    "test": "node scripts/check-props.mjs && node scripts/presets_test.mjs && node scripts/preset_adapter_test.mjs && node scripts/section_slots_test.mjs && node scripts/section_override_test.mjs && node scripts/section_order_test.mjs && node scripts/prompt_library_test.mjs && node scripts/prompt_store_test.mjs && node scripts/library_migration_test.mjs && node scripts/heartbeat_test.mjs && node scripts/session_injection_test.mjs && node scripts/host_integration_test.mjs && node scripts/client_render_test.mjs && node scripts/docs_test.mjs",
    "test:client": "node scripts/client_render_test.mjs",
    "test:docs": "node scripts/docs_test.mjs",
    "test:store": "node scripts/prompt_store_test.mjs",
    "test:props": "node scripts/check-props.mjs",
    "test:adapter": "node scripts/preset_adapter_test.mjs",
    "bump:rev": "node scripts/bump-client-rev.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "id": "dsh-prompt-easymanager",
    "name": "个人提示词",
    "version": "0.3.3",
    "repo": "XialerMoies/dsh-prompt-easymanager",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "capabilities": {
      "files": {
        "description": "读写本插件自己的数据目录（$DSH_HOME/dsh-prompt-easymanager-state.json、$DSH_HOME/prompts/）。不读也不写插件包目录以外的其他文件。",
        "scope": "plugin-data-only",
        "paths": [
          "$DSH_HOME/dsh-prompt-easymanager-state.json",
          "$DSH_HOME/prompts/catalog.json",
          "$DSH_HOME/prompts/*.md"
        ]
      },
      "network": {
        "description": "只请求本插件自己注册的本地路由（/api/prompt-easymanager/*，由 dsh 的 webServer 提供）。**不连任何外部服务**，不上传任何数据。",
        "scope": "loopback-only",
        "endpoints": [
          "/api/prompt-easymanager/*"
        ],
        "externalHosts": []
      },
      "commands": {
        "description": "不执行任何子进程或 shell 命令。",
        "scope": "none"
      },
      "credentials": {
        "description": "不读取、不存储、不传输任何凭据。源码里的 token 一词指 LLM 的 token 计数（估算提示词占用），跟身份凭据无关。",
        "scope": "none"
      },
      "systemPrompt": {
        "description": "通过 dsh 的 systemPrompt 服务注册/改写系统提示词段落。改写的是**本会话**装配时用的那份，不改 dsh 自己的文件。",
        "scope": "session-scoped"
      }
    },
    "data": {
      "location": "$DSH_HOME",
      "files": [
        "dsh-prompt-easymanager-state.json",
        "prompts/catalog.json",
        "prompts/<id>.md"
      ],
      "survivesUninstall": true,
      "note": "都是用户数据，卸载**不删**。想清干净就手工删这几个路径。"
    }
  }
}
